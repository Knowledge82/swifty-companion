<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: системный splash. Он показывает ТОЛЬКО значок по центру
         на цветном фоне (полноэкранную картинку система не разрешает).
         Значок анимированный: шестерёнки вращаются (splash_icon_animated.xml).
         Значок обрезается кругом диаметром 2/3 от 288 dp, поэтому эмблема
         нарисована внутри этого круга (tool/generate_icons.py). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <!-- 1000 мс это максимум, который система позволяет для анимации значка -->
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
